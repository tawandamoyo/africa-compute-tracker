---
import Base from '../layouts/Base.astro';
import Map from '../components/Map.astro';
import FacilityTable from '../components/FacilityTable.astro';
import CiteBlock from '../components/CiteBlock.astro';
import { loadFacilities } from '../lib/loadFacilities.js';
import { formatDate, formatStatus } from '../lib/formatters.js';
import {
  SITE, summarise, countryName, countrySlug, facilityUrl, datasetCitation, GROUP_LABEL, statusGroup,
} from '../lib/site.js';
import { dataset } from '../lib/jsonld.js';

const facilities = loadFacilities();
const s = summarise(facilities);
const groups = (['built', 'pipeline', 'stalled'] as const).filter(g => s.groups[g].length);

const byCountry = s.countries
  .map(code => ({ code, list: facilities.filter(f => f.country === code) }))
  .sort((a, b) => b.list.length - a.list.length);

const recent = [...facilities]
  .filter(f => f.last_verified)
  .sort((a, b) => b.last_verified.localeCompare(a.last_verified))
  .slice(0, 4);

const words = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const spell = (n: number) => words[n] ?? String(n);
const built = s.groups.built.length;
---

<Base
  title={SITE.name}
  description={`Which AI data centres in Africa are actually running? ${s.total} facilities in ${s.countries.length} countries, every figure sourced and dated. Free to download and cite.`}
  schema={[dataset(s)]}
>
  <!-- Hero: the built-versus-announced split is the product's point of view. -->
  <section class="grid grid-cols-1 gap-10 pt-10 pb-12 sm:pt-14 sm:pb-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-12" aria-labelledby="hero-title">
    <div>
    <h1 id="hero-title" class="text-[2rem] leading-[1.1] font-bold tracking-tight sm:text-5xl sm:leading-[1.05] lg:text-[2.75rem] xl:text-5xl">
      Of {s.total} AI-relevant data centres tracked across Africa, {spell(built)} {built === 1 ? 'is' : 'are'} operating.
    </h1>
    <p class="mt-5 max-w-prose text-lg text-muted">
      The rest are announcements, plans and stalled deals. This is an open record of AI compute
      infrastructure in {[...s.countries].sort((a, b) => facilities.filter(f => f.country === b).length - facilities.filter(f => f.country === a).length).map(countryName).join(', ').replace(/, ([^,]*)$/, ' and $1')}, where every
      figure links to its source and every record shows when it was last checked.
    </p>

    <div class="mt-10 flex flex-wrap items-start gap-x-6 gap-y-6" role="list" aria-label="Every tracked facility, grouped by status">
      {groups.map(g => (
        <div role="listitem" class="w-min min-w-[8.5rem]">
          <div class="flex gap-1.5">
            {s.groups[g].map(f => (
              <a
                href={facilityUrl(f)}
                class={`mark mark-lg mark-${g} hover:-translate-y-1 transition-transform`}
                aria-label={`${f.name}: ${formatStatus(f.status)}`}
                title={`${f.name} (${formatStatus(f.status)})`}
              ></a>
            ))}
          </div>
          <p class="mt-2 text-sm"><span class="font-semibold num">{s.groups[g].length}</span> <span class="text-muted">{GROUP_LABEL[g].toLowerCase()}</span></p>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-6 border-t border-rule pt-6 text-sm sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
      <p>
        <span class="block text-2xl font-semibold num">{s.liveMw} MW</span>
        <span class="text-muted">IT load disclosed as running today</span>
      </p>
      <p>
        <span class="block text-2xl font-semibold num">{s.plannedMw} MW</span>
        <span class="text-muted">disclosed as planned or under expansion</span>
      </p>
      <p>
        <span class="block text-2xl font-semibold num">{s.disclosing} of {s.total}</span>
        <span class="text-muted">
          facilities publish any IT-load figure, so these totals are a floor.
          <a class="link" href="/glossary/#announced-mw">How to read capacity</a>
        </span>
      </p>
    </div>
    </div>
    <Map facilities={facilities} tall label={`Map of ${s.total} tracked AI data centres in Africa`} />
  </section>

  <section id="facilities" class="scroll-mt-4" aria-labelledby="facilities-title">
    <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 id="facilities-title" class="text-2xl font-bold tracking-tight">Every facility</h2>
      <p class="text-sm text-muted">
        Dataset version {SITE.version}. Records last verified up to {formatDate(s.lastVerified)}.
      </p>
    </div>
    <FacilityTable facilities={facilities} controls caption="AI-relevant data centres tracked across Africa" />
  </section>

  <section class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div aria-labelledby="countries-title">
      <h2 id="countries-title" class="text-2xl font-bold tracking-tight">By country</h2>
      <ul class="mt-4 divide-y divide-rule border-y border-rule">
        {byCountry.map(({ code, list }) => (
          <li>
            <a href={`/countries/${countrySlug(code)}/`} class="flex items-center justify-between gap-4 py-3 hover:bg-white">
              <span class="font-medium">{countryName(code)}</span>
              <span class="flex items-center gap-3">
                <span class="flex gap-1" aria-hidden="true">
                  {list.map(f => <span class={`mark mark-${statusGroup(f.status)}`}></span>)}
                </span>
                <span class="w-24 text-right text-sm text-muted num">{list.length} {list.length === 1 ? 'facility' : 'facilities'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm text-muted">
        Not yet tracked: Ghana, Ethiopia, Rwanda, Côte d'Ivoire, Tunisia and Senegal.
        Absence means not yet recorded, not that nothing is being built.
      </p>
    </div>

    <div aria-labelledby="recent-title">
      <h2 id="recent-title" class="text-2xl font-bold tracking-tight">Recently verified</h2>
      <ul class="mt-4 divide-y divide-rule border-y border-rule">
        {recent.map(f => (
          <li class="flex items-center justify-between gap-4 py-3">
            <a href={facilityUrl(f)} class="min-w-0 truncate font-medium hover:underline">{f.name}</a>
            <time class="shrink-0 text-sm text-muted" datetime={f.last_verified}>{formatDate(f.last_verified)}</time>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm">
        <a class="link" href="/changelog/">See what changed in each release</a>
      </p>
    </div>
  </section>

  <section class="mt-16 grid grid-cols-1 gap-8 rounded border border-rule bg-white p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]" aria-labelledby="use-title">
    <div>
      <h2 id="use-title" class="text-2xl font-bold tracking-tight">Use the data</h2>
      <p class="mt-3 text-muted">
        Free to reuse under {SITE.license}. Download every record, or cite the dataset in your reporting or research.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/data/facilities.csv" download class="rounded bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-black">Download CSV</a>
        <a href="/data/facilities.json" download class="rounded border border-ink px-4 py-2 text-sm font-medium hover:bg-ink hover:text-white">Download JSON</a>
        <a href="/data/" class="px-1 py-2 text-sm link">Field guide and licence</a>
      </div>
    </div>
    <CiteBlock citation={datasetCitation()} />
  </section>
</Base>
