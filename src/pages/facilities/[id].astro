---
import Base from '../../layouts/Base.astro';
import StatusMark from '../../components/StatusMark.astro';
import CiteBlock from '../../components/CiteBlock.astro';
import SourceCitation from '../../components/SourceCitation.astro';
import ClaimCard from '../../components/ClaimCard.astro';
import ConstraintBadge from '../../components/ConstraintBadge.astro';
import AnalysisPanel from '../../components/AnalysisPanel.astro';
import { loadFacilities } from '../../lib/loadFacilities.js';
import {
  formatStatus,
  statusColor,
  formatDate,
  isStale,
  trustTierClasses,
  powerContext,
  carbonContext,
  scaleTierLabel,
  scaleTierColor,
  coolingAiLabel,
  coolingAiColor,
} from '../../lib/formatters.js';
import { SITE, liveLoad, countryName, countrySlug, slugify, statusGroup, recordCitation, issueUrl, isPlaceholderUrl, absolute, facilityUrl } from '../../lib/site.js';
import { renderNotes, plainExcerpt } from '../../lib/markdown.js';
import { breadcrumbs, DATASET_ID } from '../../lib/jsonld.js';

export function getStaticPaths() {
  const facilities = loadFacilities();
  return facilities.map(f => ({ params: { id: f.id }, props: { facility: f } }));
}

const { facility } = Astro.props;

const sourceMap = Object.fromEntries((facility.sources ?? []).map((s: any) => [s.id, s]));

type SFResult = { sourceInfo: any[]; confidence: string | null; note: string | null };
function sf(fieldPath: string): SFResult {
  const entry = facility.sourced_fields?.[fieldPath];
  if (!entry) return { sourceInfo: [], confidence: null, note: null };
  return {
    sourceInfo: (entry.source_ids ?? []).map((id: string) => sourceMap[id]).filter(Boolean),
    confidence: entry.confidence ?? null,
    note: entry.note ?? null,
  };
}

type RowData = { label: string; value: string; sourceInfo: any[]; confidence: string | null; note: string | null };
// Schema enum values (e.g. `unknown`, `surface_water`) read as plain labels.
function humanise(value: string): string {
  if (value === 'unknown') return 'Not disclosed';
  if (!/^[a-z]+(_[a-z]+)*$/.test(value)) return value;
  const text = value.replace(/_/g, ' ');
  return text[0].toUpperCase() + text.slice(1);
}

function row(label: string, value: string | string[] | null | undefined, fieldPath: string): RowData | null {
  if (value == null || value === '' || (Array.isArray(value) && value.length === 0)) return null;
  const displayValue = Array.isArray(value) ? value.join(', ') : humanise(String(value));
  return { label, value: displayValue, ...sf(fieldPath) };
}
const isRow = (r: RowData | null): r is RowData => r !== null;

const capacityRows = [
  row('IT load — full buildout',
      facility.capacity?.it_load_mw != null ? `${facility.capacity.it_load_mw} MW` : null,
      'capacity.it_load_mw'),
  row('IT load — current',
      facility.capacity?.it_load_mw_current != null ? `${facility.capacity.it_load_mw_current} MW` : null,
      'capacity.it_load_mw_current'),
  row('Total facility power',
      facility.capacity?.total_facility_mw != null ? `${facility.capacity.total_facility_mw} MW` : null,
      'capacity.total_facility_mw'),
  row('Power density',
      facility.capacity?.power_density_kw_per_rack != null ? `${facility.capacity.power_density_kw_per_rack} kW/rack` : null,
      'capacity.power_density_kw_per_rack'),
  row('GPU count (disclosed)',
      facility.capacity?.gpu_count_known != null ? facility.capacity.gpu_count_known.toLocaleString() : null,
      'capacity.gpu_count_known'),
  row('H100-equivalent GPUs',
      facility.capacity?.h100_equivalent_gpus != null ? facility.capacity.h100_equivalent_gpus.toLocaleString() : null,
      'capacity.h100_equivalent_gpus'),
  row('Building area',
      facility.capacity?.building_sqm != null ? `${facility.capacity.building_sqm.toLocaleString()} m²` : null,
      'capacity.building_sqm'),
  row('Land area',
      facility.capacity?.land_area_hectares != null ? `${facility.capacity.land_area_hectares.toLocaleString()} ha` : null,
      'capacity.land_area_hectares'),
  row('Phases planned',
      facility.capacity?.phases_planned != null ? String(facility.capacity.phases_planned) : null,
      'capacity.phases_planned'),
  row('Phases operational',
      facility.capacity?.phases_operational != null ? String(facility.capacity.phases_operational) : null,
      'capacity.phases_operational'),
].filter(isRow);

const infraRows = [
  row('Tier certification',
      facility.infrastructure?.tier_certification
        ? facility.infrastructure.tier_certification.replace('_', ' ').toUpperCase()
        : null,
      'infrastructure.tier_certification'),
  row('Cooling',
      facility.infrastructure?.cooling?.length ? facility.infrastructure.cooling.join(', ') : null,
      'infrastructure.cooling'),
  row('Connectivity',
      facility.infrastructure?.connectivity?.length ? facility.infrastructure.connectivity : null,
      'infrastructure.connectivity'),
].filter(isRow);

const powerRows = [
  row('Grid utility', facility.power?.utility, 'power.utility'),
  row('Grid carbon intensity',
      facility.power?.grid_carbon_intensity_gco2_per_kwh != null
        ? `${facility.power.grid_carbon_intensity_gco2_per_kwh} g CO₂/kWh`
        : null,
      'power.grid_carbon_intensity_gco2_per_kwh'),
  row('On-site generation',
      facility.power?.on_site_generation_mw != null ? `${facility.power.on_site_generation_mw} MW` : null,
      'power.on_site_generation_mw'),
  row('Renewable % (reported)',
      facility.power?.renewable_pct_reported != null ? `${facility.power.renewable_pct_reported}%` : null,
      'power.renewable_pct_reported'),
  row('Backup', facility.power?.backup_type, 'power.backup_type'),
  row('PPA partners', facility.power?.ppa_partners, 'power.ppa_partners'),
].filter(isRow);

const waterRows = [
  row('Water source', facility.water?.source, 'water.source'),
  row('Consumptive cooling',
      facility.water?.cooling_is_consumptive != null
        ? (facility.water.cooling_is_consumptive ? 'Yes — evaporative (water lost to atmosphere)' : 'No — closed-loop / air-cooled (water recirculated)')
        : null,
      'water.cooling_is_consumptive'),
  row('Annual use (estimated)',
      facility.water?.annual_use_megaliters_estimated != null
        ? `${facility.water.annual_use_megaliters_estimated.toLocaleString()} ML/yr`
        : null,
      'water.annual_use_megaliters_estimated'),
  row('Water stress (WRI)', facility.water?.water_stress_region, 'water.water_stress_region'),
].filter(isRow);

const financialRows = [
  row('Announced capex',
      facility.financials?.announced_capex_usd_millions != null
        ? `USD ${facility.financials.announced_capex_usd_millions.toLocaleString()}M`
        : null,
      'financials.announced_capex_usd_millions'),
  row('Investors', facility.financials?.investors, 'financials.investors'),
  row('Government incentives', facility.financials?.government_incentives, 'financials.government_incentives'),
].filter(isRow);

const govRows = [
  row('Jurisdiction', facility.governance?.jurisdiction, 'governance.jurisdiction'),
  row('Data residency', facility.governance?.data_residency_commitments, 'governance.data_residency_commitments'),
  row('Government contracts', facility.governance?.known_government_contracts, 'governance.known_government_contracts'),
  row('Foreign capital origin', facility.governance?.foreign_capital_origin, 'governance.foreign_capital_origin'),
].filter(isRow);

const entitySf = sf('tenants');
const locationStr = [facility.city, facility.region, countryName(facility.country)].filter(Boolean).join(', ');
const stale = isStale(facility.last_verified);
// Household and grid comparisons use South African figures, so only show them for ZA.
const pwrCtx = facility.country !== 'ZA' ? null : powerContext(facility.capacity?.it_load_mw, facility.city, facility.country);
const carbonCtx = carbonContext(facility.power?.grid_carbon_intensity_gco2_per_kwh);
const hasTimeline = facility.timeline?.construction_start || facility.timeline?.expected_operational || facility.timeline?.actual_operational;

const coolingAiDesc = {
  inference_only: 'Standard cooling (<50 kW/rack). Suitable for inference workloads only; not suitable for dense GPU training.',
  ai_capable: 'Liquid cooling confirmed. Suitable for AI model training and high-density inference (50–200 kW/rack).',
  frontier_training: 'High-density liquid cooling (200+ kW per rack). Capable of frontier model training with latest-generation GPUs.',
  unknown: 'Cooling adequacy for AI workloads has not been independently assessed for this facility.',
};

const trustTierDefs = {
  regulatory: 'Government filings, planning applications, official gazette notices.',
  company_official: 'Press releases, investor relations filings, and product pages from the operating company.',
  trade_press: 'Specialist outlets (DatacenterDynamics, DataCenter Knowledge, etc.) with editorial standards.',
  satellite: 'Commercial satellite imagery used to verify construction progress.',
  local_journalism: 'Local news outlets; variable editorial standards, used for leads and corroboration.',
  industry_report: 'Analyst reports (CBRE, JLL, Synergy Research, etc.) — often behind paywalls.',
  social_media: 'LinkedIn posts, job listings, tweets — lowest trust, used only as a lead.',
};
const tiersUsed: string[] = [...new Set(((facility.sources ?? []) as any[]).map((s: any) => s.trust_tier as string))];
const trustTierDefsMap = trustTierDefs as Record<string, string>;

// --- Page metadata -------------------------------------------------------------------------
const country = countryName(facility.country);
const place = [facility.city, country].filter(Boolean).join(', ');
const operatorsStr = (facility.operators ?? []).join(' and ');
const statusPhrase: Record<string, string> = {
  operational: 'an operating',
  expanded: 'an operating, expanding',
  announced: 'an announced',
  under_construction: 'an under-construction',
  paused: 'a paused',
  cancelled: 'a cancelled',
};
const mw = liveLoad(facility) ?? facility.capacity?.it_load_mw;
const metaDescription = plainExcerpt(
  `${facility.name} is ${statusPhrase[facility.status] ?? 'a'} AI-relevant data centre in ${place}` +
    `${operatorsStr ? `, operated by ${operatorsStr}` : ''}.` +
    `${mw != null ? ` ${mw} MW IT load disclosed.` : ''}` +
    ` Sourced record with ${facility.sources?.length ?? 0} citations, last verified ${formatDate(facility.last_verified)}.`,
  160
);

const crumbs: [string, string][] = [
  ['Home', '/'],
  [country, `/countries/${countrySlug(facility.country)}/`],
  [facility.name, facilityUrl(facility)],
];
const placeNode = {
  '@type': 'Place',
  '@id': `${absolute(facilityUrl(facility))}#place`,
  name: facility.name,
  alternateName: facility.aliases,
  description: plainExcerpt(facility.notes, 300) || metaDescription,
  url: absolute(facilityUrl(facility)),
  address: {
    '@type': 'PostalAddress',
    addressLocality: facility.city,
    addressRegion: facility.region,
    addressCountry: facility.country,
  },
  ...(facility.location?.lat != null && {
    geo: { '@type': 'GeoCoordinates', latitude: facility.location.lat, longitude: facility.location.lng },
  }),
  subjectOf: { '@id': DATASET_ID },
};
const pageNode = {
  '@type': 'WebPage',
  '@id': absolute(facilityUrl(facility)),
  url: absolute(facilityUrl(facility)),
  name: `${facility.name}: status, capacity and sources`,
  dateModified: facility.last_verified,
  about: { '@id': placeNode['@id'] },
  isPartOf: { '@id': `${SITE.url}/#website` },
};

// --- Key facts -------------------------------------------------------------------------------
const group = statusGroup(facility.status);
const live = liveLoad(facility);
const planned = facility.capacity?.it_load_mw;
const capacityFact =
  live == null && planned == null
    ? 'Not disclosed'
    : [live != null ? `${live} MW running` : null, planned != null ? `${planned} MW planned` : null].filter(Boolean).join(', ');
const dateFact = facility.timeline?.actual_operational
  ? ['Operating since', formatDate(facility.timeline.actual_operational)]
  : facility.timeline?.expected_operational
    ? ['Expected online', formatDate(facility.timeline.expected_operational)]
    : null;
const placeholderCount = (facility.sources ?? []).filter((x: any) => isPlaceholderUrl(x.url)).length;

---

<Base
  title={`${facility.name}, ${place}`}
  description={metaDescription}
  ogType="article"
  ogImage={`/og/facilities/${facility.id}.png`}
  published={facility.first_tracked}
  modified={facility.last_verified}
  schema={[pageNode, placeNode, breadcrumbs(crumbs)]}
>
  <nav aria-label="Breadcrumb" class="pt-6 text-sm text-muted">
    <ol class="flex flex-wrap items-center gap-x-2">
      <li><a href="/" class="hover:text-ink hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/countries/${countrySlug(facility.country)}/`} class="hover:text-ink hover:underline">{country}</a></li>
      <li aria-hidden="true">/</li>
      <li><span aria-current="page" class="text-ink">{facility.name}</span></li>
    </ol>
  </nav>

  {stale && (
    <div class="mt-5 rounded border border-pipeline/40 bg-[#fff7e8] px-4 py-3 text-sm" role="note">
      <strong>This record may be out of date.</strong> It was last verified on {formatDate(facility.last_verified)}.
      If you know of a newer source, <a class="link" href={issueUrl('source-correction')}>send a correction</a>.
    </div>
  )}

  <header class="mt-6 flex gap-5">
    <StatusMark status={facility.status} label={false} size="lg" class="mt-1.5 hidden sm:inline-flex" />
    <div class="min-w-0">
      <h1 class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{facility.name}</h1>
      {facility.aliases?.length > 0 && (
        <p class="mt-2 text-muted">Also known as {facility.aliases.join(', ')}</p>
      )}
    </div>
  </header>

  <dl class="mt-8 grid grid-cols-1 grid-cols-2 gap-px overflow-hidden rounded border border-rule bg-rule text-sm md:grid-cols-3 lg:grid-cols-6">
    <div class="bg-white p-4">
      <dt class="text-muted">Status</dt>
      <dd class="mt-1 font-semibold"><StatusMark status={facility.status} /></dd>
    </div>
    <div class="bg-white p-4">
      <dt class="text-muted">Location</dt>
      <dd class="mt-1 font-semibold">{place}</dd>
    </div>
    <div class="bg-white p-4">
      <dt class="text-muted">{facility.operators?.length > 1 ? 'Operators' : 'Operator'}</dt>
      <dd class="mt-1 font-semibold">
        {facility.operators?.length
          ? facility.operators.map((op: string, i: number) => (
              <>{i > 0 && ', '}<a class="hover:underline" href={`/operators/${slugify(op)}/`}>{op}</a></>
            ))
          : <span class="font-normal text-muted">Not disclosed</span>}
      </dd>
    </div>
    <div class="bg-white p-4">
      <dt class="text-muted">IT load</dt>
      <dd class:list={['mt-1 num', capacityFact === 'Not disclosed' ? 'text-muted' : 'font-semibold']}>{capacityFact}</dd>
    </div>
    <div class="bg-white p-4">
      <dt class="text-muted">{dateFact ? dateFact[0] : 'Timeline'}</dt>
      <dd class:list={['mt-1', dateFact ? 'font-semibold' : 'text-muted']}>{dateFact ? dateFact[1] : 'Not disclosed'}</dd>
    </div>
    <div class="bg-white p-4">
      <dt class="text-muted">Last verified</dt>
      <dd class:list={['mt-1 font-semibold', stale && 'text-pipeline']}>
        <time datetime={facility.last_verified}>{formatDate(facility.last_verified) ?? 'Unknown'}</time>
      </dd>
    </div>
  </dl>

  {facility.analysis?.significance_summary?.length > 0 && (
    <section class="mt-8 border-l-4 border-ink bg-white px-5 py-4" aria-labelledby="why-title">
      <h2 id="why-title" class="font-semibold">Why this matters</h2>
      <ul class="mt-2 list-disc space-y-1.5 pl-5">
        {(facility.analysis.significance_summary as string[]).map((bullet: string) => <li>{bullet}</li>)}
      </ul>
      <p class="mt-3 text-sm text-muted">Editorial assessment by the maintainer, not a sourced fact. Full analysis below.</p>
    </section>
  )}

  <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div class="min-w-0 space-y-10">

      {facility.notes && (
        <section aria-labelledby="overview-title">
          <h2 id="overview-title" class="text-xl font-semibold">Overview</h2>
          <div class="prose-notes mt-3 max-w-prose leading-relaxed" set:html={renderNotes(facility.notes)} />
        </section>
      )}

      {capacityRows.length > 0 && (
        <section aria-labelledby="capacity-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="capacity-title" class="text-xl font-semibold">Capacity</h2>
            <a href="/glossary/#it-load" class="text-sm link">What IT load means</a>
          </div>
          <dl>{capacityRows.map(r => <SourceCitation {...r} />)}</dl>

          {pwrCtx && (
            <div class="mt-4 rounded bg-white p-4 text-sm">
              <p class="font-semibold">Power in context</p>
              <p class="mt-1">
                {facility.capacity.it_load_mw} MW of IT load is roughly the average demand of{' '}
                <strong>{pwrCtx.households} South African households</strong> (at 250 kWh per month).
              </p>
              {pwrCtx.gridNote && <p class="mt-1">That is {pwrCtx.gridNote}.</p>}
              {pwrCtx.nationalGridNote && <p class="mt-1">It is {pwrCtx.nationalGridNote}.</p>}
              {pwrCtx.scaleNote && <p class="mt-1 text-muted">{pwrCtx.scaleNote}.</p>}
              <p class="mt-2"><a href="/glossary/#announced-mw" class="link">Announced versus operating capacity</a></p>
            </div>
          )}
        </section>
      )}

      {(infraRows.length > 0 || facility.infrastructure?.cooling_adequacy_for_ai) && (
        <section aria-labelledby="infra-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="infra-title" class="text-xl font-semibold">Infrastructure</h2>
            <a href="/glossary/#tier" class="text-sm link">Tier certification explained</a>
          </div>
          <dl>
            {infraRows.map(r => <SourceCitation {...r} />)}
            {facility.infrastructure?.cooling_adequacy_for_ai && (
              <div class="py-3">
                <dt class="text-sm text-muted">AI cooling readiness</dt>
                <dd class="mt-1">
                  <span class={`rounded px-2 py-0.5 text-sm font-medium ${coolingAiColor(facility.infrastructure.cooling_adequacy_for_ai)}`}>
                    {coolingAiLabel(facility.infrastructure.cooling_adequacy_for_ai)}
                  </span>
                  <p class="mt-2 text-sm">{coolingAiDesc[facility.infrastructure.cooling_adequacy_for_ai as keyof typeof coolingAiDesc]}</p>
                  <p class="mt-1 text-sm text-muted">
                    AI racks draw around 100 kW each, about ten times a conventional rack, so rack-level liquid cooling is the key differentiator.{' '}
                    <a href="/glossary/#ai-training-inference" class="link">Training versus inference</a>
                  </p>
                </dd>
              </div>
            )}
          </dl>
        </section>
      )}

      {powerRows.length > 0 && (
        <section aria-labelledby="power-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="power-title" class="text-xl font-semibold">Power</h2>
            <a href="/glossary/#ppa" class="text-sm link">PPAs and wheeling</a>
          </div>
          <dl>{powerRows.map(r => <SourceCitation {...r} />)}</dl>
          {carbonCtx && (
            <div class="mt-4 rounded bg-white p-4 text-sm">
              <p class="font-semibold">Grid carbon in context</p>
              <p class="mt-1">
                <strong class={carbonCtx.color}>{carbonCtx.gco2} g CO₂/kWh</strong>: {carbonCtx.label.toLowerCase()}.
                That is {carbonCtx.multiple} times the global average of {carbonCtx.global_avg} g (IEA, 2022).
                For comparison, France is about 60, the UK about 175 and the US about 400.
              </p>
              <p class="mt-1 text-muted">Grid-level estimate. PPAs and on-site renewables may lower the effective footprint.</p>
            </div>
          )}
        </section>
      )}

      {waterRows.length > 0 && (
        <section aria-labelledby="water-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="water-title" class="text-xl font-semibold">Water</h2>
            <a href="/glossary/#water-stress" class="text-sm link">Water stress explained</a>
          </div>
          <dl>{waterRows.map(r => <SourceCitation {...r} />)}</dl>
        </section>
      )}

      {financialRows.length > 0 && (
        <section aria-labelledby="fin-title">
          <h2 id="fin-title" class="border-b border-rule pb-2 text-xl font-semibold">Financials</h2>
          <dl>{financialRows.map(r => <SourceCitation {...r} />)}</dl>
        </section>
      )}

      {govRows.length > 0 && (
        <section aria-labelledby="gov-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="gov-title" class="text-xl font-semibold">Governance</h2>
            <a href="/glossary/#data-residency" class="text-sm link">Data residency explained</a>
          </div>
          <dl>{govRows.map(r => <SourceCitation {...r} />)}</dl>
        </section>
      )}

      {facility.workload_profile &&
        Object.entries(facility.workload_profile).some(([k, v]) => k !== 'notes' && v === true) && (
        <section aria-labelledby="workload-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="workload-title" class="text-xl font-semibold">Workloads</h2>
            <a href="/glossary/#ai-training-inference" class="text-sm link">Training versus inference</a>
          </div>
          <ul class="mt-3 flex flex-wrap gap-2 text-sm">
            {facility.workload_profile.ai_training && <li class="rounded bg-white px-2.5 py-1 border border-rule">AI training</li>}
            {facility.workload_profile.ai_inference && <li class="rounded bg-white px-2.5 py-1 border border-rule">AI inference</li>}
            {facility.workload_profile.general_cloud && <li class="rounded bg-white px-2.5 py-1 border border-rule">General cloud</li>}
            {facility.workload_profile.colocation && <li class="rounded bg-white px-2.5 py-1 border border-rule">Colocation</li>}
          </ul>
          {facility.workload_profile.notes && <p class="mt-3 max-w-prose text-sm">{facility.workload_profile.notes}</p>}
        </section>
      )}

      {(facility.claims as any[])?.filter((c: any) => c).length > 0 && (
        <section aria-labelledby="claims-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="claims-title" class="text-xl font-semibold">Claims</h2>
            <a href="/methodology/#claims-model" class="text-sm link">How claims work</a>
          </div>
          <p class="mt-3 max-w-prose text-sm text-muted">
            Claims are contested or still-evolving assertions, kept apart from sourced facts. A disputed claim is not a confirmed fact.
          </p>
          <div class="mt-4 space-y-3">
            {((facility.claims as any[]) ?? []).map((claim: any) => <ClaimCard claim={claim} sourceMap={sourceMap} />)}
          </div>
        </section>
      )}

      {(facility.constraints as any[])?.filter((c: any) => c).length > 0 && (
        <section aria-labelledby="constraints-title">
          <h2 id="constraints-title" class="border-b border-rule pb-2 text-xl font-semibold">Constraints</h2>
          <dl>
            {((facility.constraints as any[]) ?? []).map((constraint: any) => (
              <ConstraintBadge constraint={constraint} sourceMap={sourceMap} />
            ))}
          </dl>
        </section>
      )}

      {facility.analysis?.is_editorial && <AnalysisPanel analysis={facility.analysis as any} />}

      {(facility.claim_history as any[])?.length > 0 && (
        <details class="rounded border border-rule bg-white">
          <summary class="cursor-pointer px-5 py-4 font-semibold hover:bg-mist/60">
            Field change history <span class="font-normal text-muted">({(facility.claim_history as any[]).length})</span>
          </summary>
          <div class="px-5 pb-5">
            <p class="text-sm text-muted">Earlier values of structured fields, kept when they changed. Most recent first.</p>
            <ol class="mt-4 space-y-4 border-l border-rule pl-4">
              {([...(facility.claim_history as any[])].reverse()).map((entry: any) => (
                <li class="text-sm">
                  <p class="font-mono text-xs text-muted">{entry.field}</p>
                  <p>Previously <span class="font-medium">{String(entry.value)}</span></p>
                  <p class="text-muted">
                    Observed {entry.observed}{entry.superseded_on && `, superseded ${entry.superseded_on}`}
                  </p>
                  {entry.reason && <p class="mt-0.5 italic text-muted">{entry.reason}</p>}
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}

      {facility.sources?.length > 0 && (
        <section id="sources" aria-labelledby="sources-title">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-2">
            <h2 id="sources-title" class="text-xl font-semibold">Sources</h2>
            <a href="/methodology/#trust-tiers" class="text-sm link">How sources are ranked</a>
          </div>
          {placeholderCount > 0 && (
            <p class="mt-3 text-sm text-muted">
              {placeholderCount === 1 ? 'One source has' : `${placeholderCount} sources have`} a known title and publisher but no confirmed link yet.
              If you can find the original, <a class="link" href={issueUrl('source-correction')}>send it in</a>.
            </p>
          )}
          <ol class="mt-2 divide-y divide-rule">
            {facility.sources.map((src: any) => {
              const pending = isPlaceholderUrl(src.url);
              const href = src.archived_url ?? src.url;
              return (
                <li id={`source-${src.id}`} class="flex gap-3 py-3 text-sm scroll-mt-4">
                  <span class="mt-0.5 shrink-0 font-mono text-xs text-muted">[{src.id}]</span>
                  <div class="min-w-0">
                    {pending
                      ? <span class="font-medium">{src.title ?? 'Untitled source'}</span>
                      : <a href={href} rel="noopener" class="font-medium link break-words">{src.title ?? src.url}</a>}{src.publisher && <span class="text-muted">, {src.publisher}</span>}
                    <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-muted">
                      <span class={`rounded px-1.5 text-xs font-medium leading-5 ${trustTierClasses(src.trust_tier)}`}>
                        {src.trust_tier.replace(/_/g, ' ')}
                      </span>
                      <span>Retrieved {formatDate(src.retrieved) ?? src.retrieved}</span>
                      {pending
                        ? <span class="text-pipeline">Link not yet confirmed</span>
                        : src.archived_url
                          ? <a class="link" href={src.archived_url}>Archived copy</a>
                          : <span>Not yet archived</span>}
                    </p>
                  </div>
                </li>
              );
            })}
          </ol>

          {tiersUsed.length > 0 && (
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer font-medium">What these source types mean</summary>
              <dl class="mt-3 space-y-2">
                {tiersUsed.map(tier => (
                  <div class="flex items-start gap-2.5">
                    <dt class={`shrink-0 rounded px-1.5 text-xs font-medium leading-5 ${trustTierClasses(tier)}`}>{tier.replace(/_/g, ' ')}</dt>
                    <dd>{trustTierDefsMap[tier] ?? ''}</dd>
                  </div>
                ))}
              </dl>
            </details>
          )}
        </section>
      )}
    </div>

    <aside class="space-y-8 text-sm" aria-label="Record details">
      {(facility.operators?.length || facility.owners?.length || facility.tenants?.length) && (
        <section aria-labelledby="entities-title">
          <h2 id="entities-title" class="border-b border-rule pb-2 font-semibold">Who is involved</h2>
          <dl class="mt-3 space-y-3">
            {facility.operators?.length > 0 && (
              <div>
                <dt class="text-muted">{facility.operators.length > 1 ? 'Operators' : 'Operator'}</dt>
                {facility.operators.map((op: string) => <dd><a class="hover:underline" href={`/operators/${slugify(op)}/`}>{op}</a></dd>)}
              </div>
            )}
            {facility.owners?.length > 0 && (
              <div>
                <dt class="text-muted">{facility.owners.length > 1 ? 'Owners' : 'Owner'}</dt>
                {facility.owners.map((ow: string) => <dd>{ow}</dd>)}
              </div>
            )}
            {facility.tenants?.length > 0 && (
              <div>
                <dt class="text-muted">Known tenants{entitySf.confidence && ` (${entitySf.confidence})`}</dt>
                {facility.tenants.map((t: string) => <dd>{t}</dd>)}
                {entitySf.note && <dd class="mt-1 italic text-muted">{entitySf.note}</dd>}
              </div>
            )}
          </dl>
        </section>
      )}

      {facility.location && (
        <section aria-labelledby="location-title">
          <h2 id="location-title" class="border-b border-rule pb-2 font-semibold">Location</h2>
          <p class="mt-3">{locationStr}</p>
          {facility.location.lat != null && (
            <p class="mt-1 num text-muted">
              <a class="hover:underline" href={`https://www.openstreetmap.org/?mlat=${facility.location.lat}&mlon=${facility.location.lng}#map=12/${facility.location.lat}/${facility.location.lng}`}>
                {facility.location.lat.toFixed(4)}, {facility.location.lng.toFixed(4)}
              </a>
            </p>
          )}
          {facility.location.precision && (
            <p class="mt-1 text-muted">
              {facility.location.precision === 'exact' ? 'Exact site coordinates.' : `Coordinates are ${facility.location.precision}-level, not the exact site.`}
            </p>
          )}
        </section>
      )}

      {hasTimeline && (
        <section aria-labelledby="timeline-title">
          <h2 id="timeline-title" class="border-b border-rule pb-2 font-semibold">Timeline</h2>
          <dl class="mt-3 space-y-2">
            {facility.timeline?.construction_start && (
              <div><dt class="text-muted">Construction started</dt><dd>{formatDate(facility.timeline.construction_start)}</dd></div>
            )}
            {facility.timeline?.expected_operational && (
              <div><dt class="text-muted">Expected online</dt><dd>{formatDate(facility.timeline.expected_operational)}</dd></div>
            )}
            {facility.timeline?.actual_operational && (
              <div><dt class="text-muted">Operating since</dt><dd>{formatDate(facility.timeline.actual_operational)}</dd></div>
            )}
          </dl>
        </section>
      )}

      {facility.status_history?.length > 0 && (
        <section aria-labelledby="history-title">
          <h2 id="history-title" class="border-b border-rule pb-2 font-semibold">Status history</h2>
          <ol class="mt-3 space-y-4">
            {[...facility.status_history].reverse().map((h: any) => (
              <li class="flex gap-3">
                <StatusMark status={h.status} label={false} class="mt-1" />
                <div>
                  <p class="font-medium">{formatStatus(h.status)}, <time datetime={h.date}>{formatDate(h.date) ?? h.date}</time></p>
                  {h.note && <p class="mt-0.5 text-muted">{h.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section aria-labelledby="record-title">
        <h2 id="record-title" class="border-b border-rule pb-2 font-semibold">Cite this record</h2>
        <dl class="mt-3 grid grid-cols-1 grid-cols-[auto_1fr] gap-x-4 gap-y-1">
          <dt class="text-muted">Record ID</dt><dd class="font-mono text-xs leading-5 break-all">{facility.id}</dd>
          <dt class="text-muted">First tracked</dt><dd>{formatDate(facility.first_tracked) ?? 'Unknown'}</dd>
          <dt class="text-muted">Last verified</dt><dd>{formatDate(facility.last_verified) ?? 'Unknown'}</dd>
        </dl>
        <div class="mt-3"><CiteBlock citation={recordCitation(facility)} /></div>
      </section>

      <section class="rounded border border-rule bg-white p-4" aria-labelledby="correct-title">
        <h2 id="correct-title" class="font-semibold">Spotted an error?</h2>
        <p class="mt-1 text-muted">Corrections are handled first. You don't need to be certain, just share what you found.</p>
        <a class="mt-3 inline-block rounded bg-ink px-3 py-1.5 font-medium text-white hover:bg-black" href={issueUrl('source-correction')}>
          Report a correction
        </a>
      </section>
    </aside>
  </div>
</Base>
