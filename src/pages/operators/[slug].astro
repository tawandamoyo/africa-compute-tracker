---
import Base from '../../layouts/Base.astro';
import GroupPage from '../../components/GroupPage.astro';
import { facilitiesByOperator, countryName, countrySlug, summarise, facilityUrl, absolute } from '../../lib/site.js';
import { breadcrumbs, DATASET_ID } from '../../lib/jsonld.js';
import { plainExcerpt } from '../../lib/markdown.js';

export function getStaticPaths() {
  const all = facilitiesByOperator();
  return Object.entries(all).map(([slug, { name, facilities }]) => ({
    params: { slug },
    props: { name, facilities, others: Object.entries(all).filter(([s]) => s !== slug).map(([s, o]) => [s, o.name]) },
  }));
}

const { name, facilities, others } = Astro.props;
const s = summarise(facilities);
const n = facilities.length;
const countries = [...new Set(facilities.map((f: any) => f.country))] as string[];
const list = (xs: string[]) => xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`;
const parts = [
  s.groups.built.length && `${s.groups.built.length} operating`,
  s.groups.pipeline.length && `${s.groups.pipeline.length} announced or under construction`,
  s.groups.stalled.length && `${s.groups.stalled.length} paused or cancelled`,
].filter(Boolean) as string[];

const intro =
  `We track ${n} ${name} ${n === 1 ? 'facility' : 'facilities'} in ${list(countries.map(countryName))}: ${list(parts)}. ` +
  'Every figure links to its source.';
const title = `${name} data centres in Africa`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const crumbs: [string, string][] = [['Home', '/'], ['Operators', '/countries/#operators'], [name, path]];
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': absolute(path),
    url: absolute(path),
    name: title,
    description: intro,
    isPartOf: { '@id': DATASET_ID },
    about: { '@type': 'Organization', name },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: n,
      itemListElement: facilities.map((f: any, i: number) => ({
        '@type': 'ListItem', position: i + 1, name: f.name, url: absolute(facilityUrl(f)),
      })),
    },
  },
  breadcrumbs(crumbs),
];
---

<Base title={title} description={plainExcerpt(intro, 160)} ogImage={`/og${path.replace(/\/$/, '')}.png`} schema={schema}>
  <GroupPage title={title} intro={intro} facilities={facilities} crumbs={crumbs}>
    <section class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-semibold">Countries</h2>
        <ul class="mt-3 space-y-1.5">
          {countries.map(c => <li><a class="link" href={`/countries/${countrySlug(c)}/`}>AI data centres in {countryName(c)}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-semibold">Other operators</h2>
        <ul class="mt-3 space-y-1.5">
          {others.map(([slug, label]: [string, string]) => <li><a class="link" href={`/operators/${slug}/`}>{label}</a></li>)}
        </ul>
      </div>
    </section>
  </GroupPage>
</Base>
