---
interface Source {
  id: string;
  url: string;
  title?: string;
  archived_url?: string;
}

interface Constraint {
  dimension: string;
  severity: string;
  rationale?: string;
  source_ids?: string[];
}

interface Props {
  constraint: Constraint;
  sourceMap: Record<string, Source>;
}

const { constraint, sourceMap } = Astro.props;

const dimensionLabels: Record<string, string> = {
  grid_capacity: 'Grid capacity',
  transmission: 'Transmission',
  water_stress: 'Water stress',
  connectivity: 'Connectivity',
  land_use: 'Land use',
  regulatory: 'Regulatory',
  skilled_labour: 'Skilled labour',
  other: 'Other',
};

const severityColors: Record<string, string> = {
  low: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  medium: 'bg-amber-50 text-amber-700 border-amber-200',
  high: 'bg-orange-100 text-orange-800 border-orange-200',
  critical: 'bg-red-100 text-red-800 border-red-200',
  unknown: 'bg-gray-50 text-gray-500 border-gray-200',
};

const severityColor = severityColors[constraint.severity] ?? severityColors.unknown;
const constraintSources = (constraint.source_ids ?? []).map(id => sourceMap[id]).filter(Boolean);
---

<div class="py-3 border-b border-gray-100 last:border-0">
  <div class="flex flex-wrap items-start gap-2 mb-1">
    <span class="text-sm font-medium text-gray-800">
      {dimensionLabels[constraint.dimension] ?? constraint.dimension.replace(/_/g, ' ')}
    </span>
    <span class={`text-xs px-1.5 py-0.5 rounded border font-medium ${severityColor}`}>
      {constraint.severity}
    </span>
  </div>
  {constraint.rationale && (
    <p class="text-sm text-gray-600 leading-relaxed">{constraint.rationale}</p>
  )}
  {constraintSources.length > 0 && (
    <div class="flex items-center gap-1 mt-1.5">
      {constraintSources.map(s => (
        <a
          href={s.archived_url ?? s.url}
          target="_blank"
          rel="noopener noreferrer"
          title={s.title ?? s.url}
          class="font-mono text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-500 hover:bg-gray-200"
        >
          [{s.id}]
        </a>
      ))}
    </div>
  )}
</div>
