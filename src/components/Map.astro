---
import { statusGroup, countryName, facilityUrl } from '../lib/site.js';
import { formatStatus } from '../lib/formatters.js';
import { staticMap } from '../lib/staticMap.js';

interface Props {
  facilities: any[];
  /** Accessible description of what the map shows. */
  label?: string;
  /** Portrait frame for the home page hero, framed on the whole continent. */
  tall?: boolean;
  class?: string;
}

const { facilities, label = 'Map of tracked facilities', tall = false, class: className } = Astro.props;

// Default view: a static SVG drawn at build time (a few KB, no tiles, crawlable links).
// The interactive MapLibre map loads into the same frame only when someone asks for it.
const singleCountry = new Set(facilities.map(f => f.country)).size === 1;
const svg = staticMap({
  facilities,
  width: tall ? 500 : 700,
  height: tall ? 640 : 420,
  frame: tall || !singleCountry ? 'africa' : 'fit',
});
const MARK = { w: 10, h: 17, gap: 3 };
const rowWidth = (n: number) => n * MARK.w + (n - 1) * MARK.gap;
const hatchId = 'map-hatch'; // one map per page

// Many records use city-level coordinates, so several facilities share a point.
// Spread exact duplicates on a small ring so each stays clickable when zoomed in.
const located = facilities.filter(f => f.location?.lat != null && f.location?.lng != null);
const byPoint = new Map<string, any[]>();
for (const f of located) {
  const key = `${f.location.lat},${f.location.lng}`;
  byPoint.set(key, [...(byPoint.get(key) ?? []), f]);
}

const features = [...byPoint.values()].flatMap(group =>
  group.map((f, i) => {
    const angle = (2 * Math.PI * i) / group.length;
    const r = group.length > 1 ? 0.006 : 0;
    return {
      type: 'Feature',
      geometry: {
        type: 'Point',
        coordinates: [f.location.lng + r * Math.cos(angle), f.location.lat + r * Math.sin(angle)],
      },
      properties: {
        id: f.id,
        name: f.name,
        group: statusGroup(f.status),
        status: formatStatus(f.status),
        place: [f.city, countryName(f.country)].filter(Boolean).join(', '),
        precision: f.location.precision ?? '',
        url: facilityUrl(f),
      },
    };
  })
);

const geojson = JSON.stringify({ type: 'FeatureCollection', features });
---

<figure class:list={['relative', className]}>
  <div
    data-map
    data-geojson={geojson}
    role="region"
    aria-label={`${label}. The table below lists the same facilities.`}
    class:list={[
      'relative w-full overflow-hidden rounded border border-rule bg-[#dfe6eb]',
      tall ? 'h-[420px] sm:h-[520px] lg:h-[640px]' : 'h-[360px] sm:h-[420px]',
    ]}
  >
    <svg
      data-static-map
      viewBox={`0 0 ${svg.width} ${svg.height}`}
      preserveAspectRatio="xMidYMid meet"
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
    >
      <defs>
        <pattern id={hatchId} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="4" height="4" fill="#fff" />
          <rect width="1.6" height="4" fill="#65717C" />
        </pattern>
      </defs>
      <g stroke="#fff" stroke-width="0.8" stroke-linejoin="round">
        {svg.countries.map(c => <path d={c.d} fill={c.tracked ? '#c3ccd3' : '#eef1f3'} />)}
      </g>
      {svg.groups.map(g => {
        const w = rowWidth(g.items.length);
        const right = !g.labelLeft;
        return (
          <g transform={`translate(${g.x} ${g.y})`}>
            <g data-pin>
              <rect x={-w / 2 - 3} y={-MARK.h / 2 - 3} width={w + 6} height={MARK.h + 6} fill="#fff" rx="1.5" />
              {g.items.map((it, i) => {
                const x = -w / 2 + i * (MARK.w + MARK.gap);
                const y = -MARK.h / 2;
                return (
                  <a href={it.url} tabindex="-1" data-id={it.id}>
                    <title>{`${it.name}: ${it.status}, ${it.place}`}</title>
                    {it.group === 'built' && <rect x={x} y={y} width={MARK.w} height={MARK.h} fill="#0B7A5F" />}
                    {it.group === 'pipeline' && <rect x={x + 1} y={y + 1} width={MARK.w - 2} height={MARK.h - 2} fill="#fff" stroke="#A35F00" stroke-width="2" />}
                    {it.group === 'stalled' && <rect x={x + 1} y={y + 1} width={MARK.w - 2} height={MARK.h - 2} fill={`url(#${hatchId})`} stroke="#65717C" stroke-width="2" />}
                  </a>
                );
              })}
              {g.label && (
                <text
                  x={right ? w / 2 + 7 : -w / 2 - 7}
                  y="4"
                  text-anchor={right ? 'start' : 'end'}
                  font-size="12"
                  fill="#15212C"
                  stroke="#fff"
                  stroke-width="3"
                  paint-order="stroke"
                  style="font-family: inherit"
                >{g.label}</text>
              )}
            </g>
          </g>
        );
      })}
    </svg>
    <button
      type="button"
      data-map-load
      class="absolute bottom-3 right-3 rounded border border-rule bg-white px-3 py-1.5 text-sm font-medium text-ink shadow-sm hover:border-ink"
    >
      Explore interactive map
    </button>
  </div>
  <figcaption class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
    <span class="inline-flex items-center gap-2"><span class="mark mark-built" aria-hidden="true"></span>Operating</span>
    <span class="inline-flex items-center gap-2"><span class="mark mark-pipeline" aria-hidden="true"></span>Announced or under construction</span>
    <span class="inline-flex items-center gap-2"><span class="mark mark-stalled" aria-hidden="true"></span>Paused or cancelled</span>
    <span data-caption-static>Nearby sites share a row. Most are placed at city level, not the exact site.</span>
    <span data-caption-live hidden>Numbered circles group nearby sites; the green badge counts how many are operating. Most are placed at city level, not the exact site.</span>
  </figcaption>
</figure>

<script>
  const COLORS = { built: '#0B7A5F', pipeline: '#A35F00', stalled: '#65717C' };

  function markImage(group: keyof typeof COLORS) {
    const s = 44;
    const c = document.createElement('canvas');
    c.width = c.height = s;
    const ctx = c.getContext('2d')!;
    const color = COLORS[group];
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(4, 4, s - 8, s - 8);
    if (group === 'built') {
      ctx.fillStyle = color;
      ctx.fillRect(8, 8, s - 16, s - 16);
    } else if (group === 'stalled') {
      ctx.save();
      ctx.beginPath();
      ctx.rect(8, 8, s - 16, s - 16);
      ctx.clip();
      ctx.strokeStyle = color;
      ctx.lineWidth = 3;
      for (let x = -s; x < s * 2; x += 9) {
        ctx.beginPath();
        ctx.moveTo(x, s);
        ctx.lineTo(x + s, 0);
        ctx.stroke();
      }
      ctx.restore();
      ctx.strokeStyle = color;
      ctx.lineWidth = 5;
      ctx.strokeRect(10.5, 10.5, s - 21, s - 21);
    } else {
      ctx.strokeStyle = color;
      ctx.lineWidth = 6;
      ctx.strokeRect(11, 11, s - 22, s - 22);
    }
    return ctx.getImageData(0, 0, s, s);
  }

  // The stylesheet is injected on demand: imported as plain CSS, Astro would link it in every page head.
  import maplibreCss from 'maplibre-gl/dist/maplibre-gl.css?url';

  function loadCss(href: string) {
    return new Promise<void>((resolve, reject) => {
      if (document.querySelector(`link[href="${href}"]`)) return resolve();
      const link = Object.assign(document.createElement('link'), { rel: 'stylesheet', href });
      link.onload = () => resolve();
      link.onerror = reject;
      document.head.append(link);
    });
  }

  async function init(el: HTMLElement) {
    const [{ default: maplibregl }] = await Promise.all([import('maplibre-gl'), loadCss(maplibreCss)]);
    const data = JSON.parse(el.dataset.geojson ?? '{"type":"FeatureCollection","features":[]}');
    el.querySelector('[data-static-map]')?.remove();
    el.querySelector('[data-map-load]')?.remove();
    const figure = el.closest('figure');
    figure?.querySelector<HTMLElement>('[data-caption-static]')?.setAttribute('hidden', '');
    figure?.querySelector<HTMLElement>('[data-caption-live]')?.removeAttribute('hidden');

    const map = new maplibregl.Map({
      container: el,
      style: 'https://tiles.openfreemap.org/styles/positron',
      center: [20, 2],
      zoom: 2.4,
      cooperativeGestures: true,
      attributionControl: { compact: true },
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    map.on('load', () => {
      (['built', 'pipeline', 'stalled'] as const).forEach(g =>
        map.addImage(`mark-${g}`, markImage(g), { pixelRatio: 2 })
      );

      map.addSource('facilities', {
        type: 'geojson',
        data,
        cluster: true,
        clusterRadius: 36,
        clusterMaxZoom: 11,
        // Count operating facilities per cluster so a cluster still says how much of it is built.
        clusterProperties: { built: ['+', ['case', ['==', ['get', 'group'], 'built'], 1, 0]] },
      });

      map.addLayer({
        id: 'clusters',
        type: 'circle',
        source: 'facilities',
        filter: ['has', 'point_count'],
        paint: {
          'circle-color': '#15212C',
          'circle-radius': ['step', ['get', 'point_count'], 13, 4, 16, 8, 19],
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
        },
      });
      map.addLayer({
        id: 'cluster-count',
        type: 'symbol',
        source: 'facilities',
        filter: ['has', 'point_count'],
        layout: { 'text-field': ['get', 'point_count_abbreviated'], 'text-size': 12, 'text-font': ['Noto Sans Bold'] },
        paint: { 'text-color': '#ffffff' },
      });
      // Green badge on a cluster: how many of its facilities are operating.
      const hasBuilt = ['all', ['has', 'point_count'], ['>', ['get', 'built'], 0]];
      map.addLayer({
        id: 'cluster-built',
        type: 'circle',
        source: 'facilities',
        filter: hasBuilt,
        paint: {
          'circle-color': '#0B7A5F',
          'circle-radius': 9,
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
          'circle-translate': [14, -14],
        },
      });
      map.addLayer({
        id: 'cluster-built-count',
        type: 'symbol',
        source: 'facilities',
        filter: hasBuilt,
        layout: {
          'text-field': ['to-string', ['get', 'built']],
          'text-size': 10,
          'text-font': ['Noto Sans Bold'],
          'text-allow-overlap': true,
        },
        paint: { 'text-color': '#ffffff', 'text-translate': [14, -14] },
      });
      map.addLayer({
        id: 'points',
        type: 'symbol',
        source: 'facilities',
        filter: ['!', ['has', 'point_count']],
        layout: {
          'icon-image': ['concat', 'mark-', ['get', 'group']],
          'icon-allow-overlap': true,
          'icon-ignore-placement': true,
        },
      });

      const fit = (features: any[]) => {
        if (!features.length) return;
        const bounds = new maplibregl.LngLatBounds();
        features.forEach((f: any) => bounds.extend(f.geometry.coordinates));
        map.fitBounds(bounds, { padding: 48, maxZoom: 6, duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 400 });
      };
      fit(data.features);

      map.on('click', 'clusters', async e => {
        const feature = map.queryRenderedFeatures(e.point, { layers: ['clusters'] })[0];
        const source = map.getSource('facilities') as any;
        const zoom = await source.getClusterExpansionZoom(feature.properties.cluster_id);
        map.easeTo({ center: (feature.geometry as any).coordinates, zoom });
      });

      map.on('click', 'points', e => {
        const f = e.features?.[0];
        if (!f) return;
        const p = f.properties as Record<string, string>;
        const box = document.createElement('div');
        box.className = 'text-sm leading-snug';
        const title = document.createElement('a');
        title.href = p.url;
        title.className = 'font-semibold text-ink underline';
        title.textContent = p.name;
        const meta = document.createElement('p');
        meta.className = 'mt-1 text-muted';
        meta.textContent = `${p.status}, ${p.place}`;
        box.append(title, meta);
        new maplibregl.Popup({ offset: 12, maxWidth: '260px' })
          .setLngLat((f.geometry as any).coordinates)
          .setDOMContent(box)
          .addTo(map);
      });

      for (const layer of ['clusters', 'points']) {
        map.on('mouseenter', layer, () => (map.getCanvas().style.cursor = 'pointer'));
        map.on('mouseleave', layer, () => (map.getCanvas().style.cursor = ''));
      }

      const show = (list: string[]) => {
        const ids = new Set(list);
        const visible = data.features.filter((f: any) => ids.has(f.properties.id));
        (map.getSource('facilities') as any).setData({ ...data, features: visible });
        fit(visible);
      };
      const initial = (window as any).__facilityIds as string[] | undefined;
      if (initial) show(initial);
      document.addEventListener('facilities:filter', (e: Event) => show((e as CustomEvent).detail.ids));
    });
  }

  // Static map: keep marks a constant on-screen size whatever the frame's scale, and dim
  // facilities hidden by the table filters.
  function setupStatic(el: HTMLElement) {
    const svg = el.querySelector<SVGSVGElement>('[data-static-map]');
    if (!svg) return;
    const pins = [...svg.querySelectorAll<SVGGElement>('[data-pin]')];
    const rescale = () => {
      const k = svg.getScreenCTM()?.a;
      if (k) pins.forEach(p => p.setAttribute('transform', `scale(${1 / k})`));
    };
    rescale();
    new ResizeObserver(rescale).observe(el);

    const show = (list: string[]) => {
      const ids = new Set(list);
      svg.querySelectorAll<SVGAElement>('a[data-id]').forEach(a => {
        a.style.opacity = ids.has(a.dataset.id!) ? '' : '0.15';
      });
    };
    const initial = (window as any).__facilityIds as string[] | undefined;
    if (initial) show(initial);
    document.addEventListener('facilities:filter', (e: Event) => show((e as CustomEvent).detail.ids));
  }

  for (const el of document.querySelectorAll<HTMLElement>('[data-map]')) {
    setupStatic(el);
    el.querySelector('[data-map-load]')?.addEventListener('click', e => {
      const button = e.currentTarget as HTMLButtonElement;
      button.disabled = true;
      button.textContent = 'Loading map';
      init(el).catch(err => {
        console.error('Map failed to load', err);
        button.disabled = false;
        button.textContent = 'Map could not load. Try again';
      });
    });
  }
</script>
