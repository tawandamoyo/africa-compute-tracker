---
interface Source {
  id: string;
  url: string;
  title?: string;
  publisher?: string;
  trust_tier: string;
  archived_url?: string;
}

interface Claim {
  id: string;
  type: string;
  entity?: string;
  status: string;
  denial_status?: string;
  source_ids: string[];
  first_observed?: string;
  last_reviewed?: string;
  note?: string;
}

interface Props {
  claim: Claim;
  sourceMap: Record<string, Source>;
}

const { claim, sourceMap } = Astro.props;

const claimTypeLabels: Record<string, string> = {
  anchor_tenant: 'Anchor tenant',
  hyperscaler_presence: 'Hyperscaler presence',
  gpu_cluster: 'GPU cluster',
  liquid_cooling: 'Liquid cooling',
  sovereign_ai_project: 'Sovereign AI project',
  government_contract: 'Government contract',
  foreign_investment: 'Foreign investment',
  capacity_expansion: 'Capacity expansion',
  other: 'Other',
};

const statusColors: Record<string, string> = {
  confirmed: 'bg-emerald-100 text-emerald-800 border-emerald-200',
  reported: 'bg-blue-100 text-blue-800 border-blue-200',
  disputed: 'bg-red-100 text-red-800 border-red-200',
  denied: 'bg-gray-200 text-gray-600 border-gray-300',
  withdrawn: 'bg-gray-100 text-gray-500 border-gray-200',
};

const denialLabels: Record<string, string> = {
  unaddressed: 'Unaddressed by parties',
  denied_by_one_party: 'Denied by one party',
  denied_by_both: 'Denied by both parties',
  confirmed_since: 'Subsequently confirmed',
  n_a: '',
};

const isDisputed = claim.status === 'disputed';
const statusColor = statusColors[claim.status] ?? 'bg-gray-100 text-gray-600 border-gray-200';
const borderAccent = isDisputed ? 'border-l-4 border-l-red-400' : 'border-l-4 border-l-blue-200';
const claimSources = (claim.source_ids ?? []).map(id => sourceMap[id]).filter(Boolean);
---

<div class={`bg-white border border-gray-200 rounded-lg p-4 ${borderAccent}`}>
  <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded">{claim.id}</span>
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">
        {claimTypeLabels[claim.type] ?? claim.type.replace(/_/g, ' ')}
      </span>
      {claim.entity && (
        <span class="text-sm font-semibold text-gray-900">{claim.entity}</span>
      )}
    </div>
    <div class="flex flex-wrap items-center gap-1.5">
      <span class={`text-xs px-2 py-0.5 rounded-full font-medium border ${statusColor}`}>
        {claim.status}
        {isDisputed && ' ⚠'}
      </span>
    </div>
  </div>

  {claim.denial_status && claim.denial_status !== 'n_a' && (
    <p class="text-xs text-gray-500 mb-2">
      <span class="font-medium">Denial status:</span> {denialLabels[claim.denial_status] ?? claim.denial_status}
    </p>
  )}

  {claim.note && (
    <p class="text-sm text-gray-700 leading-relaxed mb-3">{claim.note}</p>
  )}

  <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400">
    {claim.first_observed && (
      <span>First observed: {claim.first_observed}</span>
    )}
    {claim.last_reviewed && (
      <span>Last reviewed: {claim.last_reviewed}</span>
    )}
    <div class="flex items-center gap-1">
      {claimSources.map(s => (
        <a
          href={s.archived_url ?? s.url}
          target="_blank"
          rel="noopener noreferrer"
          title={s.title ?? s.url}
          class="font-mono text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-500 hover:bg-gray-200"
        >
          [{s.id}]
        </a>
      ))}
    </div>
  </div>
</div>
