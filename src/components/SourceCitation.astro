---
import { confidenceClasses, trustTierClasses } from '../lib/formatters.js';

interface Source {
  id: string;
  url: string;
  title?: string;
  publisher?: string;
  trust_tier: string;
  archived_url?: string;
}

interface Props {
  label: string;
  value: string;
  sourceInfo?: Source[];
  confidence?: string | null;
  note?: string | null;
}

const { label, value, sourceInfo = [], confidence, note } = Astro.props;

const accentClass =
  confidence === 'disputed' ? 'border-l-4 border-l-red-500 pl-3' :
  confidence === 'estimated' ? 'border-l-4 border-l-pipeline pl-3' : '';
---

<div class:list={['flex flex-wrap items-start justify-between gap-x-4 gap-y-1 border-b border-rule py-3 last:border-0', accentClass]}>
  <div class="min-w-0 flex-1">
    <dt class="text-sm text-muted">{label}</dt>
    <dd class="mt-0.5">{value}</dd>
    {note && <dd class="mt-1 max-w-prose text-sm italic text-muted">{note}</dd>}
  </div>
  <dd class="flex flex-wrap items-center gap-1.5 sm:pt-5">
    {confidence && (
      <span class={`rounded border px-1.5 text-xs font-medium leading-5 ${confidenceClasses(confidence)}`}>{confidence}</span>
    )}
    {sourceInfo.map(s => (
      <a
        href={`#source-${s.id}`}
        title={`${s.title ?? s.publisher ?? 'Source'} (${s.trust_tier.replace(/_/g, ' ')})`}
        class={`rounded px-1.5 font-mono text-xs font-medium leading-5 hover:underline ${trustTierClasses(s.trust_tier)}`}
      >
        <span class="sr-only">Source </span>[{s.id}]
      </a>
    ))}
  </dd>
</div>
