---
import { confidenceClasses, trustTierClasses } from '../lib/formatters.js';

interface Source {
  id: string;
  url: string;
  title?: string;
  publisher?: string;
  trust_tier: string;
  archived_url?: string;
}

interface Props {
  label: string;
  value: string;
  sourceInfo?: Source[];
  confidence?: string | null;
  note?: string | null;
}

const { label, value, sourceInfo = [], confidence, note } = Astro.props;

const accentClass =
  confidence === 'disputed' ? 'border-l-2 border-l-red-400 pl-3 -ml-3' :
  confidence === 'estimated' ? 'border-l-2 border-l-amber-400 pl-3 -ml-3' : '';

const confidenceIcon =
  confidence === 'disputed' ? ' ⚠' :
  confidence === 'estimated' ? ' ≈' : '';
---

<div class={`py-3 border-b border-gray-100 last:border-0 ${accentClass}`}>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
    <div class="min-w-0 flex-1">
      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">{label}</dt>
      <dd class="text-sm text-gray-900">{value}</dd>
      {note && <p class="text-xs text-gray-400 mt-0.5 italic">{note}</p>}
    </div>
    <div class="flex items-center gap-1.5 flex-wrap pt-4">
      {confidence && (
        <span class={`text-xs px-1.5 py-0.5 rounded border font-medium ${confidenceClasses(confidence)}`}>
          {confidence}{confidenceIcon}
        </span>
      )}
      {sourceInfo.map(s => (
        <a
          href={s.archived_url ?? s.url}
          target="_blank"
          rel="noopener noreferrer"
          title={`${s.title ?? s.publisher ?? s.url} [${s.trust_tier.replace(/_/g, ' ')}]`}
          class={`text-xs px-1.5 py-0.5 rounded font-mono font-medium hover:opacity-80 ${trustTierClasses(s.trust_tier)}`}
        >
          [{s.id}]
        </a>
      ))}
    </div>
  </div>
</div>
